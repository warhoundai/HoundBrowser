  "components": {
    "schemas": {
      "CommandInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Id"
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Idempotencykey"
          },
          "action": {
            "type": "string",
            "enum": [
              "alias_test",
              "assert",
              "back",
              "click",
              "close_tab",
              "diagnostics",
              "evaluate",
              "forward",
              "http",
              "key",
              "navigate",
              "new_tab",
              "observe",
              "rate_test",
              "screenshot",
              "scroll",
              "select",
              "switch_tab",
              "tabs",
              "type"
            ],
            "title": "Action"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          },
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          },
          "agent": {
            "type": "string",
            "title": "Agent",
            "default": "primary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "idempotencyKey",
          "action",
          "revision"
        ],
        "title": "CommandInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SessionInput": {
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/SessionScope"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scope"
        ],
        "title": "SessionInput"
      },
      "SessionScope": {
        "properties": {
          "origin": {
            "type": "string",
            "title": "Origin"
          },
          "methods": {
            "items": {
              "type": "string",
              "enum": [
                "GET",
                "HEAD",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            },
            "type": "array",
            "title": "Methods",
            "default": [
              "GET",
              "HEAD"
            ]
          },
          "writePaths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Writepaths",
            "default": []
          },
          "credentialProfile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credentialprofile"
          },
          "websockets": {
            "type": "boolean",
            "title": "Websockets",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin"
        ],
        "title": "SessionScope"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "serviceKey": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
